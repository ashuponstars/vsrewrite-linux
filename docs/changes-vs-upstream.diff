+	// The mod was made on Windows, where file names are not case sensitive. On Linux a script asking for
+	// "majincutscene" must still find "majinCutscene.mp4", so a path that does not exist as spelled is
+	// matched against the real directory listings one folder at a time, ignoring case.
+	static var caseDirCache:Map<String, Map<String, String>> = [];
+	static var caseFixCache:Map<String, String> = [];
+
+	static function fixCase(path:String):String
+	{
+		#if (linux || mac)
+		if (FileSystem.exists(path)) return path;
+		var cached:Null<String> = caseFixCache.get(path);
+		if (cached != null) return cached;
+
+		var parts:Array<String> = path.split('/');
+		var cur:String = parts.shift();
+		for (part in parts)
+		{
+			if (part == '' || part == '.' || part == '..') { cur += '/' + part; continue; }
+			var listing:Map<String, String> = caseDirCache.get(cur);
+			if (listing == null)
+			{
+				listing = [];
+				if (FileSystem.exists(cur) && FileSystem.isDirectory(cur))
+					for (name in FileSystem.readDirectory(cur)) listing.set(name.toLowerCase(), name);
+				caseDirCache.set(cur, listing);
+			}
+			var real:Null<String> = listing.get(part.toLowerCase());
+			if (real == null) return path; // really missing
+			cur += '/' + real;
+		}
+		caseFixCache.set(path, cur);
+		return cur;
+		#else
+		return path;
+		#end
 	}
 
